{
  "name": "nexus-saas-suite",
  "version": "1.0.0",
  "description": "Full-Stack NexusSaaS Business Management, Inventory & Attendance Suite",
  "main": "run-fullstack.js",
  "scripts": {
    "start": "node run-fullstack.js",
    "dev": "node run-fullstack.js",
    "dev:backend": "cd backend && node src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:scanner": "cd scanner-service && python app.py",
    "install:scanner": "cd scanner-service && pip install -r requirements.txt",
    "build": "cd frontend && npm run build",
    "seed": "cd backend && node src/seed.js",
    "seed:developers": "cd backend && node src/seedDevelopers.js",
    "test": "cd backend && node test-suite.js",
    "test:runner": "cd backend && node test-runner.js",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:push": "cd backend && npx prisma db push",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "saas",
    "react",
    "express",
    "prisma",
    "fullstack",
    "inventory",
    "attendance",
    "vite"
  ],
  "author": "",
  "license": "ISC"
}
